# 进程时区（与业务展示一致；生产亦由 ecosystem 强制）
TZ=Asia/Shanghai

# MySQL 连接 URI（与 admin 同一条；一个变量含主机/用户/密码/库名，勿再拆 DB_HOST 等）
# 本地开发请用 NUXT_DATABASE_URL（Nuxt 仅用 NUXT_ 覆盖 runtimeConfig）
# Aiven 等要求 TLS 时追加 ?ssl-mode=REQUIRED
DATABASE_URL=mysql://user:password@127.0.0.1:3306/admin
NUXT_DATABASE_URL=mysql://user:password@127.0.0.1:3306/admin

# NotifyX 发送密钥（仅服务端；部署脚本会自动补 NUXT_NOTIFYX_KEY）
NOTIFYX_KEY=
